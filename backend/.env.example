# Copy to .env for local development. Never commit .env.
APP_ENV=dev

# Supabase dashboard → Project Settings → API → Project URL (no trailing slash)
SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase dashboard → Connect → "Session pooler" tab, then swap the scheme to postgresql+asyncpg.
# Use the *pooler* host: the direct db.<ref>.supabase.co host is IPv6-only.
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
